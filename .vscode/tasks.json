{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: venv + dependencies",
      "type": "shell",
      "command": "./setup.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run all tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python test_indicators.py && ${workspaceFolder}/.venv/bin/python test_logic.py && ${workspaceFolder}/.venv/bin/python test_gui.py",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Doctor (offline)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python doctor.py",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Doctor + API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python doctor.py --api",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
